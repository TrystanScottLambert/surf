# Copy to `.env` (git-ignored) and fill in, using KEY=value lines.
# Values are read ONLY at build time and baked (obfuscated) into the binary.
# Use an R2 API token with "Object Read only" permission scoped to the bucket.
SURF_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SURF_R2_ACCESS_KEY_ID=
SURF_R2_SECRET_ACCESS_KEY=
SURF_R2_BUCKET=waves-rips
# Alternatively, instead of SURF_R2_ENDPOINT:
# SURF_R2_ACCOUNT_ID=
